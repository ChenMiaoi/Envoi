{
  "name": "envoi-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "predev": "node scripts/sync-pdfjs-assets.mjs",
    "dev": "electron-vite dev --config electron.vite.config.ts",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "build": "tsc -b && tsc -p tsconfig.electron.json && electron-vite build --config electron.vite.config.ts",
    "dev:desktop": "electron-vite dev --config electron.vite.config.ts",
    "build:desktop": "tsc -b && tsc -p tsconfig.electron.json && electron-vite build --config electron.vite.config.ts",
    "package:mac": "npm run build:desktop && electron-builder --mac --config electron-builder.yml",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:references": "node scripts/test-references.mjs",
    "test": "npm run test:references && node scripts/test-library.mjs",
    "test:local": "node --test scripts/test-tool-discovery.mjs && node scripts/test-native-compiler.mjs && node scripts/test-compiler.mjs && node scripts/test-templates.mjs && node scripts/test-git.mjs && node scripts/test-git-status.mjs && node scripts/test-git-log.mjs && node scripts/test-git-graph.mjs && node scripts/test-diagnostics.mjs && node scripts/test-lint.mjs && node scripts/test-tool-config.mjs",
    "test:demo": "node scripts/test-demo-navigation.mjs && node scripts/test-diagnostic-restore.mjs",
    "demo:build": "node scripts/build-demo.mjs && node scripts/sync-demo-snapshot.mjs",
    "demo:snapshot": "node scripts/sync-demo-snapshot.mjs",
    "test:ai": "node scripts/test-chat-markdown.mjs && node scripts/test-model-discovery.mjs && node scripts/test-provider-validation.mjs && node scripts/test-agent-native.mjs && node scripts/test-data-migration.mjs",
    "i18n:traditional": "node scripts/i18n-traditional.mjs",
    "i18n:inventory": "node scripts/i18n-inventory.mjs",
    "predev:desktop": "node scripts/sync-pdfjs-assets.mjs",
    "prebuild:desktop": "node scripts/sync-pdfjs-assets.mjs",
    "test:desktop": "node --test scripts/test-workspace-trust.mjs scripts/test-desktop-backend.mjs scripts/test-example-project.mjs scripts/test-workspaces.mjs && node scripts/test-desktop-smoke.mjs && node scripts/test-workspace-ui.mjs",
    "dev:web": "vite",
    "build:web": "tsc -b && vite build",
    "measure:startup": "node scripts/measure-startup.mjs",
    "package:win": "npm run build:desktop && electron-builder --win --config electron-builder.yml --config.electronDist=node_modules/electron/dist"
  },
