{
  "name": "envoi",
  "private": true,
  "version": "0.5.4",
  "license": "Apache-2.0",
  "description": "Envoi local academic writing workspace",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/ensure-app-deps.mjs --force",
    "predev": "node scripts/ensure-app-deps.mjs",
    "dev": "npm --prefix app run dev",
    "prebuild": "node scripts/ensure-app-deps.mjs",
    "build": "npm --prefix app run build",
    "format": "npm --prefix app run format",
    "format:check": "npm --prefix app run format:check",
    "test": "npm --prefix app test",
    "test:ai": "npm --prefix app run test:ai",
    "test:local": "npm --prefix app run test:local",
    "test:demo": "npm --prefix app run test:demo",
    "ci:check": "node scripts/ci-check.mjs",
    "lint": "npm --prefix app run lint",
    "demo:build": "npm --prefix app run demo:build",
    "demo:snapshot": "npm --prefix app run demo:snapshot",
    "dev:desktop": "npm --prefix app run dev:desktop",
    "build:desktop": "npm --prefix app run build:desktop",
    "package:mac": "npm --prefix app run package:mac",
    "test:desktop": "npm --prefix app run test:desktop",
    "test:desktop:quick": "npm --prefix app run test:desktop:quick",
    "test:desktop:visible": "npm --prefix app run test:desktop:visible",
    "demo:git": "node app/scripts/init-demo-git.mjs",
    "package:win": "npm --prefix app run package:win",
    "check:local": "node scripts/ci-check.mjs --local",
    "test:workflow": "node --test scripts/test-check-workflow.mjs"
  }
}
